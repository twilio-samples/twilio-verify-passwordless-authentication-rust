<!DOCTYPE html>
<html>
<head>
    <title>Sign In</title>
    <link href="https://assets.twilio.com/public_assets/paste-fonts/1.5.2/fonts.css" rel="stylesheet">
    <link href="/assets/css/paste.css" rel="stylesheet">
</head>
<body class="container">
    <main>
        <h1>Sign In</h1>
        <form action="/" method="post" class="mt-60">
            <div class="mb-60">
                <label for="phone">Enter your phone number:</label>
                <input
                    id="phone"
                    inputmode="tel"
                    name="phone"
                    required
                    type="tel"
                >
            </div>
            <button type="submit" class="primary">Send OTP</button>
        </form>
        <section>
            Text: {{ text }}
        </section>
    </main>
</body>
</html>

